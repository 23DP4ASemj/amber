# NODE_ENV defaults to development on the API; set production on your hosting platform.
PORT=3001
# Demo is local-only, with sample products and an in-memory order store.
DEMO_MODE=true
WEBAPP_URL=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated numeric user IDs authorized to update order status.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
INIT_DATA_MAX_AGE_SECONDS=3600
SHOP_NAME=Amber & Smoke
DISTRICTS=Centrs,Zolitūde,Imanta,Salaspils
BLOCKED_DISTRICTS=
DISABLED_CATEGORIES=
HIDE_SOLD_OUT=false
MINIMUM_AGE=18
LEGAL_NOTICE=For adults only. Availability and delivery depend on your district.
AGE_VERIFICATION_MODE=declaration
# For external mode: trusted HTTPS endpoint accepting user_id, minimum_age, token.
AGE_VERIFICATION_URL=
AGE_VERIFICATION_API_KEY=
# Durable volume, required in production. One API process / one replica only.
DATA_DIR=./data
TRUST_PROXY_HOPS=0
# Optional for separately deployed frontend; never put secrets in VITE_*.
VITE_API_URL=
